{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 scripts/validate_deck.py *)",
      "WebFetch(domain:scryfall.com)",
      "WebFetch(domain:api.scryfall.com)",
      "WebFetch(domain:edhrec.com)",
      "Bash(python scripts/validate_deck.py *)",
      "Bash(python3 scripts/scryfall_lookup.py *)",
      "Bash(python scripts/scryfall_lookup.py *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate_on_save.py"
          }
        ]
      }
    ]
  }
}
